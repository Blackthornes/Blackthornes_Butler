<!-- The game loads this file by itself; it is not listed in the TOC.
     The Butler Bags key (UI/BagWindow.lua) clicks a hidden secure button
     that opens and closes Butler's bag window, whether Use Butler Bags is
     on or off. -->
<Bindings>
    <Binding name="BLACKTHORNESBUTLER_TOGGLE" header="BLACKTHORNESBUTLER" category="ADDONS">
        if BlackthornesButler and BlackthornesButler.UI then BlackthornesButler.UI:Toggle() end
    </Binding>
    <Binding name="CLICK BlackthornesButlerBagsKey:LeftButton" category="ADDONS"/>
</Bindings>
